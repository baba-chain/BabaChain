# BabaChain Simple Docker Image (for local development)
FROM ubuntu:22.04

# Metadata
LABEL maintainer="BabaChain Team <team@babachain.org>"
LABEL description="BabaChain Proof-of-Stake Cryptocurrency Node (Development)"
LABEL version="1.0.0-dev"

# Çevre değişkenleri
ENV DEBIAN_FRONTEND=noninteractive
ENV BABACHAIN_USER=babachain
ENV BABACHAIN_HOME=/home/babachain
ENV BABACHAIN_DATA=/home/babachain/.babachain

# Sistem güncellemesi ve temel paketler
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    gosu \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# BabaChain kullanıcısı oluşturma
RUN useradd -m -s /bin/bash $BABACHAIN_USER && \
    mkdir -p $BABACHAIN_DATA && \
    chown -R $BABACHAIN_USER:$BABACHAIN_USER $BABACHAIN_HOME

# Pre-built binaries kopyalama (eğer varsa)
# Bu kısım daha sonra gerçek binary'ler ile değiştirilecek
RUN mkdir -p /usr/local/bin

# Konfigürasyon dosyası şablonu
COPY docker/babachain.conf.template $BABACHAIN_DATA/babachain.conf.template
RUN chown $BABACHAIN_USER:$BABACHAIN_USER $BABACHAIN_DATA/babachain.conf.template

# Entrypoint scripti
COPY docker/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Dummy binaries oluştur (geliştirme için)
RUN echo '#!/bin/bash\necho "BabaChain Daemon v1.0.0-dev"\necho "Starting in development mode..."\nsleep infinity' > /usr/local/bin/babachaind && \
    echo '#!/bin/bash\necho "BabaChain CLI v1.0.0-dev"\necho "Development mode - limited functionality"' > /usr/local/bin/babachain-cli && \
    chmod +x /usr/local/bin/babachaind /usr/local/bin/babachain-cli

# Portları aç
EXPOSE 9999 9998

# Volume'lar
VOLUME ["$BABACHAIN_DATA"]

# Çalışma dizini
WORKDIR $BABACHAIN_HOME

# Entrypoint
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["babachaind"]